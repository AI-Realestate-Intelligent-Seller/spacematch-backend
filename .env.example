# SpaceMatch Reels MVP v0.5 - owner sign-up, broker invites by email.
# Public URL of the app people open: the Next.js frontend (../frontend), e.g. http://localhost:3000 locally.
# Used for links in emails (invites, password resets) and secure cookies when it is https.
BASE_URL=http://localhost:3000
# Required when BASE_URL is not localhost (generated into .dev-keys.json for local use):
# SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY=

# Database. With DATABASE_URL set the app uses Postgres; without it, SQLite at DB_PATH.
# Supabase: use the *Session pooler* string (Connect -> Session pooler). The direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from most networks.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5
# Log every SQL statement (debugging only).
DATABASE_LOGGING=false
DB_PATH=data/spacematch_reels.db

# Broker invite emails. Leave SMTP_HOST empty to print invites to the console
# (the owner also gets a copyable invite link in the app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SpaceMatch <no-reply@example.com>
# starttls | ssl | none
SMTP_SECURITY=starttls
INVITE_TTL_HOURS=72

# Instagram through Apify (residential proxies; works from Render). Empty = browser only.
APIFY_TOKEN=
# YouTube through the official YouTube Data API v3 (Google Cloud API key). Empty = browser only.
YOUTUBE_API_KEY=

# Free public counters (Playwright, local browser, no login/cookies).
# How many times to scroll an Instagram Reels tab looking for an older reel.
PLAYWRIGHT_MAX_SCROLLS=80

# Hub API (/v1). The server runs a background refresh queue and a daily refresh.
# Only one server may run them against a shared database. Default: ON when BASE_URL is a deployed
# address, OFF on localhost. Uncomment to force (e.g. on for a laptop using its own SQLite file).
# REFRESH_WORKER=on
DAILY_REFRESH_ENABLED=true
DAILY_REFRESH_TIME=07:00
DAILY_REFRESH_TZ=America/Chicago
# Manual refresh per property is allowed once per this many seconds (429 + Retry-After otherwise).
MANUAL_REFRESH_COOLDOWN_S=600
# Requests per minute per API key.
API_RATE_LIMIT_PER_MIN=120
# Seconds between reads in background refreshes (be gentle with the platforms).
READ_DELAY_S=3
