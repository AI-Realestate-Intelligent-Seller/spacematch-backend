    {
      "name": "5. Refreshes",
      "description": "Refresh returns 202 with a refresh; poll **Get refresh** until `done`, `partial` or `failed`. If one is already queued/running for the property, that one is returned. A second manual refresh within the cooldown (10 min) returns 429 with `Retry-After`.\n\n**Note:** with `REFRESH_WORKER=on` the server really opens a hidden browser and reads the platforms.",
      "item": [
        {
          "name": "Refresh now",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/properties/{{propertyId}}/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "properties",
                "{{propertyId}}",
                "refresh"
              ]
            },
            "description": "Optional `platforms: [\"instagram\"]` to read only some platforms.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requested_by\": \"agent@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of [202, 429]', () => pm.expect(pm.response.code).to.be.oneOf([202, 429]));",
                  "if (pm.response.code === 202) pm.environment.set('refreshId', pm.response.json().refresh.id);",
                  "if (pm.response.code === 429) console.log('Cooldown - retry after', pm.response.headers.get('Retry-After'), 's');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get refresh (poll)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/refreshes/{{refreshId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "refreshes",
                "{{refreshId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Has status', () => pm.expect(pm.response.json().status).to.be.oneOf(['queued','running','done','partial','failed','cancelled']));"
                ]
              }
            }
          ]
        },
        {
          "name": "List refreshes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/refreshes?property_id={{propertyId}}&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "refreshes"
              ],
              "query": [
                {
                  "key": "property_id",
                  "value": "{{propertyId}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Filters: `property_id`, `trigger`, `status`, `from`, `to`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bulk refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/refreshes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "refreshes"
              ]
            },
            "description": "Or `{\"all_active\": true}`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property_ids\": [\n    \"{{propertyId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.expect(pm.response.code).to.equal(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/refreshes/{{refreshId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "refreshes",
                "{{refreshId}}",
                "cancel"
              ]
            },
            "description": "Only queued refreshes can be cancelled (409 otherwise)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of [200, 409]', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        }
      ]
    },
