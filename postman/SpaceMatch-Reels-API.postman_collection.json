    {
      "name": "7. Error examples",
      "description": "What the Hub should expect. Every error is `{\"error\": {code, message, field}}`.",
      "item": [
        {
          "name": "401 - no API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "properties"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.expect(pm.response.code).to.equal(401));",
                  "pm.test('code unauthorized', () => pm.expect(pm.response.json().error.code).to.equal('unauthorized'));"
                ]
              }
            }
          ]
        },
        {
          "name": "422 - property without links",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "properties"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"1 No Links St\",\n  \"links\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.expect(pm.response.code).to.equal(422));",
                  "pm.test('field links', () => pm.expect(pm.response.json().error.field).to.equal('links'));"
                ]
              }
            }
          ]
        },
        {
          "name": "422 - invalid link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "properties"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"2 Bad Link St\",\n  \"links\": [\n    \"https://www.instagram.com/reel/DTOz5t5jLQH/\",\n    \"https://example.com/video/1\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.expect(pm.response.code).to.equal(422));",
                  "const e = pm.response.json().error;",
                  "pm.test('invalid_link on links[1]', () => { pm.expect(e.code).to.equal('invalid_link'); pm.expect(e.field).to.equal('links[1]'); });"
                ]
              }
            }
          ]
        },
